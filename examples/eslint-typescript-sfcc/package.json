{
  "name": "@commerce-klaus/example-eslint-typescript-sfcc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run lint:cartridges && vp run typecheck:cartridges && vp run test",
    "lint": "eslint cartridges",
    "prepare": "vp run setup:b2c-plugin",
    "typecheck:cartridges": "b2c klaus types sync --min-version 26.7.0 && b2c klaus types check",
    "types:sfcc:sync": "b2c klaus types sync --min-version 26.7.0",
    "types:sfcc:sync:force": "b2c klaus types sync --force"
  },
  "devDependencies": {
    "@commerce-klaus/b2c-plugin": "workspace:*",
    "@commerce-klaus/config": "workspace:*",
    "@commerce-klaus/eslint-config-sfcc": "workspace:*",
    "@commerce-klaus/typescript-sfcc": "workspace:*",
    "@commerce-klaus/vitest-sfcc": "workspace:*",
    "@eslint/js": "catalog:",
    "@salesforce/b2c-cli": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "eslint-plugin-unicorn": "catalog:",
    "globals": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
