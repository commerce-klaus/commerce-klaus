{
  "name": "sfcc-dev-tooling",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "predocs:dev": "vp run docs:generate",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "version-packages": "changeset version",
    "version-packages-lockfile": "changeset version && vp install --lockfile-only -- --link-workspace-packages && vp fmt",
    "release": "vp pm publish -r --report-summary",
    "release:output": "jq -c '.publishedPackages[] | {type: \"git-tag\", tag: (.name + \"@\" + .version), packageName: .name}' pnpm-publish-summary.json > \"$CHANGESETS_OUTPUT\"",
    "ready": "vp check && vp run -r test && vp run -r build && vp run docs:build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "mermaid": "^12.0.0",
    "vite-plus": "catalog:",
    "vitepress": "2.0.0-alpha.20",
    "vitepress-plugin-blog": "0.2.0",
    "vue": "^3.5.42"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.5.1"
}
