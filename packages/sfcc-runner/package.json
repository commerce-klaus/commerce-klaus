{
  "name": "@commerce-klaus/sfcc-runner",
  "version": "0.0.1",
  "description": "Execute existing SFCC cartridge logic from specialized Node.js tools",
  "keywords": [
    "cartridge",
    "commercecloud",
    "salesforce",
    "sfcc"
  ],
  "homepage": "https://commerce-klaus.github.io/commerce-klaus/packages/sfcc-runner/",
  "bugs": {
    "url": "https://github.com/commerce-klaus/commerce-klaus/issues"
  },
  "license": "MIT",
  "author": "Jens Simon <https://github.com/jenssimon>",
  "repository": {
    "type": "git",
    "url": "https://github.com/commerce-klaus/commerce-klaus",
    "directory": "packages/sfcc-runner"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@commerce-klaus/sfcc-module-resolver": "workspace:^",
    "@commerce-klaus/sfcc-test-runtime": "workspace:^",
    "acorn": "catalog:",
    "acorn-walk": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.21.0"
}
